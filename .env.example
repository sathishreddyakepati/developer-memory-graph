# FalkorDB Cloud Connection Configuration
# Copy this file to .env and fill in your actual credentials.
# Do not commit .env to version control.

FALKORDB_HOST=your-instance.falkordb.cloud
FALKORDB_PORT=6379
FALKORDB_USERNAME=default
FALKORDB_PASSWORD=your-secure-password
FALKORDB_TLS=false

# OpenRouter LLM Configuration
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=cohere/north-mini-code:free

# Request Timeout Configuration (Optional, in seconds: bounded between 5 and 120, default: 30)
OPENROUTER_TIMEOUT=30
